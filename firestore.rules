rules_version = '2';

// Reglas de seguridad de RecyTrack.
//
// Principio: la cadena de verificación no puede saltarse etapas ni ser
// manipulada por quien no corresponde. Un colaborador crea depósitos solo a su
// nombre y en su área, el validador valida solo los de su planta, y el
// certificado únicamente lo emite el administrador de la planta al registrar
// el retiro de un depósito ya validado. Nadie se autoasigna un rol: al
// validador lo nombra el administrador, y ser administrador exige un código
// que solo estas reglas pueden comprobar (ver codigosRol más abajo).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function miPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function miRol() {
      return miPerfil().rol;
    }

    /** Los campos que cambiaron en esta escritura, para permitir solo algunos. */
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    /** La planta de quien escribe, o null si todavía no pertenece a ninguna. */
    function miPlanta() {
      return miPerfil().get('plantaId', null);
    }

    /** Quien escribe administra la planta `plantaId`. */
    function esAdminDe(plantaId) {
      return autenticado() && miRol() == 'administrador' && plantaId != null && miPlanta() == plantaId;
    }

    /** Quien escribe es el validador o el administrador de la planta `plantaId`. */
    function esValidadorOAdminDe(plantaId) {
      return autenticado()
        && miRol() in ['validador', 'administrador']
        && plantaId != null
        && miPlanta() == plantaId;
    }

    /** Quien lee pertenece a la planta `plantaId`, con cualquier rol. */
    function dePlanta(plantaId) {
      return autenticado() && plantaId != null && miPlanta() == plantaId;
    }

    // ------------------------------------------------------------ códigosRol
    // Un documento por planta con el código que habilita promoverse a
    // administrador de ella. Nadie los lee desde la app: `allow read: if false`
    // los esconde incluso de un usuario autenticado. Solo estas reglas los
    // consultan con get() para comparar el código que la persona escribió
    // contra el real. Se crean a mano desde la consola de Firebase, junto con
    // la planta. Nadie los escribe desde la app: si un administrador pudiera,
    // cambiaría el código de otra planta y se daría a sí mismo ese rol.
    match /codigosRol/{plantaId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- plantas
    // La planta se crea a mano en la consola, junto con su código de
    // administrador: es la siembra inicial del piloto, no una acción de la app.
    match /plantas/{plantaId} {
      allow read: if autenticado();
      allow write: if false;
    }

    // ----------------------------------------------------------------- áreas
    // Cada área tiene un código para que la gente se una a ella y su dotación
    // (cuántas personas trabajan ahí), que es la base del % de participación.
    // Se leen sin restricción porque quien se une busca su área por el
    // código. Solo el administrador de la planta crea y edita sus
    // áreas, y no puede pasarlas a otra planta.
    function areaValida(datos) {
      return datos.keys().hasOnly(['plantaId', 'nombre', 'codigo', 'dotacion'])
        && datos.nombre is string && datos.nombre.size() > 0 && datos.nombre.size() <= 60
        && datos.codigo is string && datos.codigo.size() >= 4 && datos.codigo.size() <= 20
        && datos.dotacion is int && datos.dotacion >= 0;
    }

    match /areas/{areaId} {
      allow read: if autenticado();

      allow create: if esAdminDe(request.resource.data.plantaId)
                    && areaValida(request.resource.data);

      allow update: if esAdminDe(resource.data.plantaId)
                    && request.resource.data.plantaId == resource.data.plantaId
                    && areaValida(request.resource.data);

      // Los perfiles y depósitos apuntan a su área: no se borra.
      allow delete: if false;
    }

    // -------------------------------------------------------------- usuarios
    /** El área existe, es de la planta `plantaId` y `nombre` es su nombre real (se copia al perfil). */
    function areaDePlanta(areaId, nombre, plantaId) {
      let ruta = /databases/$(database)/documents/areas/$(areaId);
      return areaId is string
        && exists(ruta)
        && get(ruta).data.nombre == nombre
        && get(ruta).data.plantaId == plantaId;
    }

    match /usuarios/{uid} {
      // Cada quien lee su propio perfil, y el administrador los de su planta
      // para gestionar a las personas desde el panel. Nadie más: así un
      // colaborador no descarga los correos de sus compañeros ni ve lo que
      // recicla cada uno. El perfil de un administrador guarda el código que
      // presentó (codigoRolUsado), pero solo lo ven él y otro administrador de
      // la misma planta, que ya lo conoce.
      allow read: if autenticado()
                  && (request.auth.uid == uid || esAdminDe(resource.data.get('plantaId', null)));

      // Cada quien crea su propio perfil al registrarse, siempre como
      // colaborador, sin área o ya unido a un área real. Nadie nace validador
      // ni administrador: al validador lo nombra el administrador, y para ser
      // administrador hay que presentar el código de la planta (más abajo).
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.rol == 'colaborador'
                    && !('codigoRolUsado' in request.resource.data)
                    && (
                      (request.resource.data.get('plantaId', null) == null
                       && request.resource.data.get('areaId', null) == null)
                      ||
                      areaDePlanta(request.resource.data.areaId,
                                   request.resource.data.areaNombre,
                                   request.resource.data.plantaId)
                    );

      allow update: if autenticado() && (
        (
          request.auth.uid == uid && (
            // Cualquier rol: editar su nombre o marcar los avisos como vistos.
            soloCambia(['nombre', 'avisosVistosHasta'])
            ||
            // Un colaborador se une a un área con su código, pero solo si
            // todavía no tiene una. Cambiarse de área lo hace el administrador:
            // si cada quien pudiera, se pasaría al área que va perdiendo para
            // inflarle la participación.
            (
              resource.data.rol == 'colaborador'
              && resource.data.get('areaId', null) == null
              && soloCambia(['plantaId', 'areaId', 'areaNombre'])
              && areaDePlanta(request.resource.data.areaId,
                              request.resource.data.areaNombre,
                              request.resource.data.plantaId)
            )
            ||
            // Promoción a administrador de una planta: solo con su código. El
            // administrador no compite (no deposita), así que queda sin área.
            (
              resource.data.rol == 'colaborador'
              && request.resource.data.rol == 'administrador'
              && soloCambia(['rol', 'plantaId', 'areaId', 'areaNombre', 'codigoRolUsado'])
              && request.resource.data.get('areaId', null) == null
              && request.resource.data.get('areaNombre', null) == null
              && request.resource.data.codigoRolUsado ==
                 get(/databases/$(database)/documents/codigosRol/$(request.resource.data.plantaId)).data.administrador
            )
          )
        )
        ||
        // El administrador cambia a una persona de su planta de área, o la
        // nombra validadora o la devuelve a colaboradora. No puede hacer
        // administrador a nadie ni sacarla de la planta.
        (
          request.auth.uid != uid
          && esAdminDe(resource.data.get('plantaId', null))
          && resource.data.rol in ['colaborador', 'validador']
          && request.resource.data.rol in ['colaborador', 'validador']
          && soloCambia(['rol', 'areaId', 'areaNombre'])
          && areaDePlanta(request.resource.data.areaId,
                          request.resource.data.areaNombre,
                          resource.data.plantaId)
        )
      );

      allow delete: if false;
    }

    // ------------------------------------------------------------- registros

    // Kilos estimados por material y talla de bolsa. Debe coincidir con
    // KG_POR_TALLA en app/src/lib/tipos.ts: si se calibra uno, se calibra el otro.
    function kgPorTalla() {
      return {
        'Plástico':     {'S': 0.1, 'M': 0.4, 'L': 0.8, 'XL': 1.5},
        'Papel/cartón': {'S': 0.4, 'M': 1.2, 'L': 2.5, 'XL': 5},
        'Metal':        {'S': 0.3, 'M': 0.8, 'L': 1.5, 'XL': 3},
        'Vidrio':       {'S': 1.5, 'M': 4,   'L': 8,   'XL': 12}
      };
    }

    // ---------------------------------------------------------- contenedores
    // Un documento por contenedor físico, con id = el código de su QR (p. ej.
    // "K7QM9X"), aleatorio y no adivinable. Leer uno exige conocer su código,
    // o sea haberlo escaneado frente al contenedor; listarlos solo pueden el
    // validador (para su ronda) y el administrador (para imprimir sus QR) de
    // esa planta. Así nadie registra un depósito desde su casa escribiendo un
    // código que se imagina. `punto` es el nombre del punto limpio donde está:
    // así sirve igual si la planta tiene uno o varios.
    match /contenedores/{codigo} {
      allow get: if autenticado();
      allow list: if esValidadorOAdminDe(resource.data.plantaId);

      // Mixto (material null) o de uno de los materiales de la tabla.
      allow create: if esAdminDe(request.resource.data.plantaId)
                    && request.resource.data.keys().hasOnly(['plantaId', 'punto', 'material', 'activo', 'creadoEn'])
                    && request.resource.data.punto is string
                    && request.resource.data.punto.size() > 0
                    && request.resource.data.punto.size() <= 60
                    && request.resource.data.activo == true
                    && (request.resource.data.material == null
                        || request.resource.data.material in kgPorTalla());

      // Lo único que se cambia es desactivarlo (al quitarlo o al cambiarle el
      // código): los depósitos hechos en él siguen apuntando a este documento.
      allow update: if esAdminDe(resource.data.plantaId)
                    && soloCambia(['activo'])
                    && request.resource.data.activo == false;

      allow delete: if false;
    }

    // ----------------------------------------------------------- incidencias
    // Contenedor encontrado contaminado (p. ej. vidrio en el de cartón). Lo
    // reporta el validador o el administrador de la planta, sobre un
    // contenedor de esa planta. No lleva datos personales: no se sabe quién
    // fue, y por eso no señala a nadie. Lo marca como atendido el
    // administrador al registrar el retiro de ese contenedor (ver retiros).
    match /incidencias/{incidenciaId} {
      allow read: if dePlanta(resource.data.plantaId);

      allow create: if esValidadorOAdminDe(request.resource.data.plantaId)
                    && request.resource.data.keys().hasOnly([
                         'plantaId', 'contenedor', 'contenedorNombre', 'contaminante',
                         'reportadoEn', 'reportadoPor', 'atendida', 'atendidaEn', 'retiroId'])
                    && request.resource.data.reportadoPor == request.auth.uid
                    && request.resource.data.atendida == false
                    && request.resource.data.atendidaEn == null
                    && request.resource.data.retiroId == null
                    && request.resource.data.contaminante in
                       ['Vidrio', 'Plástico', 'Papel/cartón', 'Metal', 'Orgánico', 'Basura común']
                    && exists(/databases/$(database)/documents/contenedores/$(request.resource.data.contenedor))
                    && get(/databases/$(database)/documents/contenedores/$(request.resource.data.contenedor)).data.plantaId
                       == request.resource.data.plantaId;

      // El administrador la da por atendida en el mismo lote en que registra
      // el retiro de ese contenedor: desde ahí deja de advertirse.
      allow update: if esAdminDe(resource.data.plantaId)
                    && resource.data.atendida == false
                    && request.resource.data.atendida == true
                    && soloCambia(['atendida', 'atendidaEn', 'retiroId'])
                    && retiroIncluye(request.resource.data.retiroId, resource.data);

      // Un reporte forma parte del historial de calidad de la planta: no se borra.
      allow delete: if false;
    }

    // ---------------------------------------------------------------- retiros
    // Cada vez que se lleva el material del punto limpio (del día o de la
    // semana), el administrador lo registra: fecha, quién retiró, la guía si
    // la hay, qué contenedores salieron y el peso si se lo informaron. Ese
    // registro es la etapa 2 de la cadena: en el mismo lote se certifican los
    // depósitos validados de esos contenedores (ver registros) y se dan por
    // atendidas sus incidencias. Lo leen las personas de la planta (el
    // certificado del colaborador menciona el retiro) y no se edita ni se borra.
    function retiroIncluye(retiroId, registro) {
      let ruta = /databases/$(database)/documents/retiros/$(retiroId);
      return retiroId is string
        && existsAfter(ruta)
        && getAfter(ruta).data.plantaId == registro.plantaId
        && registro.contenedor in getAfter(ruta).data.contenedores;
    }

    match /retiros/{retiroId} {
      allow read: if dePlanta(resource.data.plantaId);

      allow create: if esAdminDe(request.resource.data.plantaId)
                    && request.resource.data.keys().hasOnly([
                         'plantaId', 'fecha', 'quienRetira', 'guia', 'contenedores', 'pesoKg',
                         'depositos', 'kgEstimado', 'registradoPor', 'registradoEn'])
                    && request.resource.data.registradoPor == request.auth.uid
                    && request.resource.data.registradoEn is int
                    && math.abs(request.resource.data.registradoEn - request.time.toMillis()) <= 600000
                    && request.resource.data.fecha is int
                    && request.resource.data.quienRetira is string
                    && request.resource.data.quienRetira.size() > 0
                    && request.resource.data.quienRetira.size() <= 80
                    && (request.resource.data.guia == null
                        || (request.resource.data.guia is string && request.resource.data.guia.size() <= 40))
                    && request.resource.data.contenedores is list
                    && request.resource.data.contenedores.size() > 0
                    && (request.resource.data.pesoKg == null
                        || (request.resource.data.pesoKg is number && request.resource.data.pesoKg > 0))
                    && request.resource.data.depositos is int
                    && request.resource.data.depositos >= 0
                    && request.resource.data.kgEstimado is number
                    && request.resource.data.kgEstimado >= 0;

      allow update, delete: if false;
    }

    // El depósito debe hacerse en un contenedor que exista, esté activo, sea de
    // la planta del depósito y, si es de un material, reciba ese material.
    function contenedorValido(deposito) {
      let ruta = /databases/$(database)/documents/contenedores/$(deposito.contenedor);
      return exists(ruta)
        && get(ruta).data.plantaId == deposito.plantaId
        && get(ruta).data.activo == true
        && (get(ruta).data.material == null || get(ruta).data.material == deposito.material);
    }

    match /registros/{registroId} {
      // Cada colaborador lee solo sus depósitos: el ranking de áreas sale del
      // resumen del mes (ver resumenes), así nadie ve lo que recicla un
      // compañero. El validador y el administrador leen los de su planta para
      // validar, registrar retiros y armar el reporte. El depósito no guarda
      // el nombre de la persona: el panel lo cruza con su perfil.
      allow read: if autenticado()
                  && (resource.data.colaboradorId == request.auth.uid
                      || esValidadorOAdminDe(resource.data.plantaId));

      // Un depósito lo registra un colaborador, siempre a su nombre y en estado
      // pendiente, en su propia planta y área y en un contenedor real de ella
      // (ver contenedorValido), con una talla de bolsa válida y exactamente los
      // kilos que esa talla estima para ese material: nadie puede inventar
      // kilos, contenedores ni materiales, ni siquiera escribiendo directo a la
      // base de datos.
      //
      // Planta y área se copian del perfil y deben coincidir con él: si no,
      // alguien podría declarar depósitos en otra área y subirle la
      // participación. La fecha debe ser la de ahora (con 10 minutos de margen
      // por relojes desajustados), para que nadie retroceda un depósito a una
      // semana anterior y cumpla una misión que ya pasó. Y no se aceptan
      // campos de más ni etapas ya llenas. El validador y el administrador no
      // depositan: luego validarían sus propios depósitos.
      allow create: if autenticado()
                    && miRol() == 'colaborador'
                    && request.resource.data.keys().hasOnly([
                         'colaboradorId', 'plantaId', 'areaId',
                         'material', 'talla', 'kgDeclarado', 'kgConfirmado', 'contenedor',
                         'estado', 'creadoEn', 'validadoEn', 'validadoPor',
                         'certificadoEn', 'certificadoPor', 'codigo', 'retiroId'])
                    && request.resource.data.colaboradorId == request.auth.uid
                    && request.resource.data.plantaId == miPlanta()
                    && request.resource.data.areaId is string
                    && request.resource.data.areaId == miPerfil().get('areaId', null)
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.creadoEn is int
                    && math.abs(request.resource.data.creadoEn - request.time.toMillis()) <= 600000
                    && request.resource.data.kgConfirmado == null
                    && request.resource.data.validadoEn == null
                    && request.resource.data.validadoPor == null
                    && request.resource.data.certificadoEn == null
                    && request.resource.data.certificadoPor == null
                    && request.resource.data.codigo == null
                    && request.resource.data.retiroId == null
                    && contenedorValido(request.resource.data)
                    && request.resource.data.material in kgPorTalla()
                    && request.resource.data.talla in ['S', 'M', 'L', 'XL']
                    && request.resource.data.kgDeclarado ==
                       kgPorTalla()[request.resource.data.material][request.resource.data.talla];

      allow update: if autenticado() && (
        // Etapa 1: el validador (o el administrador, si lo reemplaza) de ESA
        // planta valida o rechaza un pendiente, firmando con su propio uid. No
        // puede alterar de quién es el depósito, qué material era, ni nada de
        // la etapa 2. Al validar confirma los kilos declarados, no otros:
        // valida el contenedor completo, no pesa bolsa por bolsa, y así
        // tampoco puede inflar los kilos de la planta. Al rechazar, los kilos
        // confirmados no se tocan.
        (
          esValidadorOAdminDe(resource.data.plantaId)
          && resource.data.estado == 'pendiente'
          && request.resource.data.validadoPor == request.auth.uid
          && (
            (
              request.resource.data.estado == 'validado'
              && request.resource.data.kgConfirmado == resource.data.kgDeclarado
              && soloCambia(['estado', 'kgConfirmado', 'validadoEn', 'validadoPor'])
            )
            ||
            (
              request.resource.data.estado == 'rechazado'
              && soloCambia(['estado', 'validadoEn', 'validadoPor'])
            )
          )
        )
        ||
        // Etapa 2: el administrador de la planta registra el retiro del
        // material y, en el mismo lote, certifica los depósitos validados de
        // los contenedores retirados, firmando con su propio uid. Solo toca los
        // campos de certificación: el peso y el material quedaron fijados en la
        // etapa 1. El retiro debe existir al terminar el lote, ser de la misma
        // planta e incluir el contenedor del depósito: así no se certifica nada
        // que no haya salido de verdad.
        (
          esAdminDe(resource.data.plantaId)
          && resource.data.estado == 'validado'
          && request.resource.data.estado == 'certificado'
          && request.resource.data.certificadoPor == request.auth.uid
          && request.resource.data.codigo is string
          && soloCambia(['estado', 'certificadoEn', 'certificadoPor', 'codigo', 'retiroId'])
          && retiroIncluye(request.resource.data.retiroId, resource.data)
        )
      );

      // Un registro de trazabilidad no se borra.
      allow delete: if false;
    }
  }
}
